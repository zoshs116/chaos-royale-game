# Browser client. VITE_ values are included in the public web bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BATTLE_WS_URL=ws://127.0.0.1:8787/battle
VITE_CHAOS_DEV_MULTIPLAYER_TOKEN=

# Local multiplayer only. Never configure this bypass in production.
CHAOS_DEV_MULTIPLAYER_TOKEN=
CHAOS_GATEWAY_PORT=8788
CHAOS_REALTIME_PORT=8787

# Dedicated realtime server. SUPABASE_SERVICE_ROLE_KEY is server-only.
CHAOS_STORAGE_DRIVER=memory
CHAOS_POSTGRES_URL=
CHAOS_ALLOWED_ORIGINS=
CHAOS_SERVER_BUILD=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
